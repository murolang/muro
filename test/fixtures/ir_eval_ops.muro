def scat : run Π (a : String) → Π (b : String) → String := λ (a : String) → λ (b : String) → strCat a b

def slen : run Π (a : String) → Nat := λ (a : String) → strLen a

def seq : run Π (a : String) → Π (b : String) → WBool := λ (a : String) → λ (b : String) → strEq a b

def sbytes : run Π (a : String) → Bytes := λ (a : String) → strBytes a

def bcat : run Π (a : Bytes) → Π (b : Bytes) → Bytes := λ (a : Bytes) → λ (b : Bytes) → bytesCat a b

def blen : run Π (a : Slice) → U64 := λ (a : Slice) → sliceLen a

def beq : run Π (a : Slice) → Π (b : Slice) → WBool := λ (a : Slice) → λ (b : Slice) → sliceEq a b

def bsub : run Π (s : Slice) → Π (o : U64) → Π (n : U64) → Slice := λ (s : Slice) → λ (o : U64) → λ (n : U64) → slice s o n

def bget : run Π (s : Slice) → Π (i : U64) → Opt U8 := λ (s : Slice) → λ (i : U64) → sliceGet s i

def bunc : run Π (s : Slice) → Maybe (U8 × Slice) := λ (s : Slice) → sliceUncons s

def btil : run Π (s : Slice) → Π (b : U8) → Slice := λ (s : Slice) → λ (b : U8) → sliceUntil s b

def baft : run Π (s : Slice) → Π (b : U8) → Slice := λ (s : Slice) → λ (b : U8) → sliceAfter s b

def bsum : run Π (s : Slice) → U64 :=
  λ (s : Slice) → sliceFold U64 (toU64 0) (λ (b : U8) → λ (rest : Slice) → λ (n : U64) → addi (muli n (toU64 31)) (asU64 b)) s

def bcount : run Π (s : Slice) → Π (c : U8) → U64 :=
  λ (s : Slice) → λ (c : U8) →
    sliceFold U64 (toU64 0) (λ (b : U8) → λ (rest : Slice) → λ (n : U64) →
      match (eqi b c) motive (λ _ → U64)
        | wtrue => addi n (sliceLen rest)
        | wfalse => n) s

def unwrap : run Π (o : Opt U64) → Π (d : U64) → U64 :=
  λ (o : Opt U64) → λ (d : U64) →
    match o motive (λ _ → U64)
      | wsome x => x
      | wnone => d

def swap : run Π (p : U8 × String) → String × U8 :=
  λ (p : U8 × String) → let (a, b) = p in (b, a)
