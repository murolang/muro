-- ir_eval_ops.muro — one run per word, string, and bytes operation.
-- test/muro_ir_diff_test.exs applies each run to the edge values of
-- its argument kinds and compares Muro.Check.normalize/3 with
-- Muro.IR.Eval on the default, shared, and closure images.
import "std:maybe.muro"

