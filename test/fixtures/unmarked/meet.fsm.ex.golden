  defmodule Box do
    @moduledoc """
    One end of session `box`. The state is opaque: thread it, compare it
    with ==, and do not depend on its shape.
    """

    def init, do: MeetFsm.muro_fsm_init("box", [])

    def unquote(:send)(state, value) do
      MeetFsm.muro_fsm_step("box", :send, state, value)
    end

    def recv(state, value) do
      MeetFsm.muro_fsm_step("box", :recv, state, value)
    end

