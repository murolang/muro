      MeetFsm.muro_fsm_step("back", :send, state, value)
    end

    def recv(state, value) do
      MeetFsm.muro_fsm_step("back", :recv, state, value)
    end

    def done?(state), do: MeetFsm.muro_fsm_done?("back", state)

    def expected(state), do: MeetFsm.muro_fsm_expected("back", state)

    def check_trace(trace) when is_list(trace) do
