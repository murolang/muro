-- list_cover with reserved names that exhaust, cover splits, and
-- reach nests used to hard-code (k0, rk0, e0, l0, h0, t0, i, u).
import "../../examples/cshrl/std/nat.muro"
import "../../examples/cshrl/lib/agent.muro"

data State : Type where
  cell : Π (xs : List Nat) → State

data Action : Type where
  go : Action
  stay : Action

data Marker : Type where
  k0 : Marker
  rk0 : Marker
  e0 : Marker
  l0 : Marker
  h0 : Marker
  t0 : Marker
  i : Marker
  u : Marker
  f0_0 : Marker
  p0_0 : Marker
  car : Marker

def Reward : spec Type := Nat

def step : run Π (st : State) → Π (a : Action) → State × Reward :=
  λ (st : State) → λ (a : Action) →
    match st motive (λ _ → State × Reward)
      | cell xs =>
          (match a motive (λ _ → State × Reward)
            | go =>
                (match xs motive (λ _ → State × Reward)
                  | nil => (cell nil, 0)
                  | cons hd tl => (cell (cons hd tl), suc 0))
            | stay =>
                (match xs motive (λ _ → State × Reward)
                  | nil => (cell nil, suc 0)
                  | cons hd tl => (cell (cons hd tl), 0)))

def le : spec Π (r : Reward) → Π (q : Reward) → Type := Le
def max : run Π (r : Reward) → Π (q : Reward) → Reward := maxN
def bottom : run Reward := 0
def all-actions : run List Action := cons go (cons stay nil)
def default-action : run Action := stay
def horizon : run Nat := suc 0
def all-states : run List State :=
  cons (cell nil) (cons (cell (cons 0 nil)) nil)
