-- synth_lam.muro — a finite graph for the synthesis loop.
-- The features are readings. A state name is not a feature.
-- uses-gt1 and arg-apps-ne0 hold together at copy, copy4, copy8, and len.
-- The trace prefers arg at each copy state and prefers spine at len.
import "../../examples/cshrl/std/nat.muro"
import "../../examples/cshrl/std/list.muro"

data State : Type where
  copy   : State
  copy4  : State
  copy8  : State
  len    : State
  ready  : State
  ready4 : State
  ready8 : State
  done   : State
  cold   : State
  wlen   : State

data Action : Type where
  arg   : Action
  spine : Action

def Carrier : spec Type := State

data Feature : Type where
  uses-gt1     : Feature
  arg-apps-ne0 : Feature

def eval-feature : run Π (+ f : Feature) → Π (+ c : Carrier) → Bool :=
  λ (+ f : Feature) → λ (+ c : Carrier) →
    match f motive (λ _ → Bool)
      | uses-gt1 =>
          (match c motive (λ _ → Bool)
            | copy => true
            | copy4 => true
            | copy8 => true
            | len => true
            | ready => false
            | ready4 => false
            | ready8 => false
            | done => false
            | cold => false
            | wlen => false)
      | arg-apps-ne0 =>
          (match c motive (λ _ → Bool)
            | copy => true
            | copy4 => true
            | copy8 => true
            | len => true
            | ready => false
            | ready4 => false
            | ready8 => false
            | done => false
            | cold => false
            | wlen => false)

def step : run Π (s : State) → Π (a : Action) → State × Nat :=
  λ (s : State) → λ (a : Action) →
    match s motive (λ _ → State × Nat)
      | copy =>
          (match a motive (λ _ → State × Nat)
            | arg => (done, 0)
            | spine => (cold, 0))
      | copy4 =>
          (match a motive (λ _ → State × Nat)
            | arg => (done, 0)
            | spine => (cold, 0))
      | copy8 =>
          (match a motive (λ _ → State × Nat)
            | arg => (done, 0)
            | spine => (cold, 0))
      | len =>
          (match a motive (λ _ → State × Nat)
            | arg => (wlen, 0)
            | spine => (done, 0))
      | ready =>
          (match a motive (λ _ → State × Nat)
            | arg => (done, suc 0)
            | spine => (done, suc 0))
      | ready4 =>
          (match a motive (λ _ → State × Nat)
            | arg => (done, suc 0)
            | spine => (done, suc 0))
      | ready8 =>
          (match a motive (λ _ → State × Nat)
            | arg => (done, suc 0)
            | spine => (done, suc 0))
      | done =>
          (match a motive (λ _ → State × Nat)
            | arg => (done, suc 0)
            | spine => (done, suc 0))
      | cold =>
          (match a motive (λ _ → State × Nat)
            | arg => (cold, 0)
            | spine => (cold, 0))
      | wlen =>
          (match a motive (λ _ → State × Nat)
            | arg => (wlen, 0)
            | spine => (wlen, 0))

def all-actions : run List Action := cons arg (cons spine nil)
def default-action : run Action := spine
def horizon : run Nat := suc 0

def all-states : run List State :=
  cons copy
    (cons copy4
      (cons copy8
        (cons len
          (cons ready
            (cons ready4
              (cons ready8
                (cons done
                  (cons cold
                    (cons wlen nil)))))))))
