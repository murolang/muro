defmodule HalfOk do
  # Generated by Muro. Evidence never becomes a run.

  def plus(x0, x1) when is_integer(x0) and x0 >= 0 and is_integer(x1) and x1 >= 0 do
    x0 + x1
  end
  
  def half(x0) do
    case x0 do
    0 -> 0
    x1 when is_integer(x1) and x1 > 0 -> (x1 = x1 - 1; case x1 do
    0 -> 0
    x2 when is_integer(x2) and x2 > 0 -> (x2 = x2 - 1; (half(x2) + 1))
  end)
  end
  end

end
