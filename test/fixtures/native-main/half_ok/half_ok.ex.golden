defmodule HalfOk do
  # Generated by Muro. Evidence never becomes a run.

  def plus(x0, x1) do
    case x0 do
    0 -> x1
    {:suc, x2} -> {:suc, plus(x2, x1)}
  end
  end
  
  def half(x0) do
    case x0 do
    0 -> 0
    {:suc, x1} -> case x1 do
    0 -> 0
    {:suc, x2} -> {:suc, half(x2)}
  end
  end
  end

end
