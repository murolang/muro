defmodule FnvSlice do
  # Generated by Muro. Evidence never becomes a run.

  def offset do
    2166136261
  end
  
  def prime do
    16777619
  end
  
  def mix(x0, x1) do
    Muro.Word.mul(:u32, Muro.Word.bxor(:u32, x0, Muro.Word.cast(:u32, x1)), prime())
  end
  
  def hash(x0) do
    (fn f, z, s -> recur = fn recur, acc, cur -> case cur do <<>> -> acc; <<b, rest::binary>> -> recur.(recur, f.(b).(rest).(acc), rest) end end; recur.(recur, z, s) end).(fn x1 -> fn _ -> fn x3 -> mix(x3, x1) end end end, offset(), x0)
  end
  
  def hashEmpty do
    hash("")
  end
  
  def hashA do
    hash("a")
  end
  defp muro_nat_to_int(0), do: 0
  defp muro_nat_to_int({:suc, n}), do: 1 + muro_nat_to_int(n)
end
