defmodule Bytes do
  # Generated by Muro. Evidence never becomes a run.

  def hello do
    "hello"
  end
  
  def ff do
    <<255>>
  end
  
  def nul do
    <<0>>
  end
  
  def nl do
    "\n"
  end
  
  def cr do
    "\r"
  end
  
  def tab do
    "\t"
  end
  
  def quoted do
    "a\"b"
  end
  
  def slash do
    "a\\b"
  end
  
  def accent do
    "é"
  end
  
  def empty do
    ""
  end
  
  def parts do
    ("hel") <> ("lo")
  end
  
  def from_str do
    "hello"
  end
  
  def from_parts do
    ("hel") <> ("lo")
  end
  
  def n_hello do
    byte_size("hello")
  end
  
  def n_accent do
    byte_size("é")
  end
  
  def n_ff do
    byte_size(<<255>>)
  end
  
  def n_cat do
    byte_size(("hel") <> ("lo"))
  end
  
  def n_slice do
    byte_size("hello")
  end
  
  def yes do
    ("ab") == ("ab")
  end
  
  def no do
    ("ab") == ("ba")
  end
  
  def yes_slice do
    ("ab") == (("a") <> ("b"))
  end
  
  def mid do
    (fn s, off, len -> n = byte_size(s); if off < 0 or len < 0 or off > n or len > n - off, do: <<>>, else: :binary.part(s, off, len) end).("hello", 1, 3)
  end
  
  def past do
    (fn s, off, len -> n = byte_size(s); if off < 0 or len < 0 or off > n or len > n - off, do: <<>>, else: :binary.part(s, off, len) end).("ab", 5, 1)
  end
  
  def over do
    (fn s, off, len -> n = byte_size(s); if off < 0 or len < 0 or off > n or len > n - off, do: <<>>, else: :binary.part(s, off, len) end).("ab", 1, 9)
  end
  
  def at0 do
    (fn s, i -> if i >= 0 and i < byte_size(s), do: {:some, :binary.at(s, i)}, else: :none end).("ab", Muro.Word.of(:u64, muro_nat_to_int(0)))
  end
  
  def at1 do
    (fn s, i -> if i >= 0 and i < byte_size(s), do: {:some, :binary.at(s, i)}, else: :none end).("ab", 1)
  end
  
  def miss do
    (fn s, i -> if i >= 0 and i < byte_size(s), do: {:some, :binary.at(s, i)}, else: :none end).("ab", 2)
  end
  
  def method do
    (fn s, b -> case :binary.match(s, <<b>>) do :nomatch -> s; {pos, _} -> :binary.part(s, 0, pos) end end).("GET /x", 32)
  end
  
  def whole do
    (fn s, b -> case :binary.match(s, <<b>>) do :nomatch -> s; {pos, _} -> :binary.part(s, 0, pos) end end).("GET", 32)
  end
  
  def path do
    (fn s, b -> case :binary.match(s, <<b>>) do :nomatch -> <<>>; {pos, 1} -> :binary.part(s, pos + 1, byte_size(s) - pos - 1) end end).("GET /x", 32)
  end
  
  def no_path do
    (fn s, b -> case :binary.match(s, <<b>>) do :nomatch -> <<>>; {pos, 1} -> :binary.part(s, pos + 1, byte_size(s) - pos - 1) end end).("GET", 32)
  end
  
  def sum2 do
    (fn f, z, s -> recur = fn recur, acc, cur -> case cur do <<>> -> acc; <<b, rest::binary>> -> recur.(recur, f.(b).(rest).(acc), rest) end end; recur.(recur, z, s) end).(fn x0 -> fn _ -> fn x2 -> Muro.Word.add(:u64, x2, Muro.Word.cast(:u64, x0)) end end end, Muro.Word.of(:u64, muro_nat_to_int(0)), <<1, 2>>)
  end
  defp muro_nat_to_int(0), do: 0
  defp muro_nat_to_int({:suc, n}), do: 1 + muro_nat_to_int(n)
end
