-- Same delayed-reward cover as synth_fresh_reach_js, plus Feature
-- constructors named rk0, k0, and f0_0. After Reach tabulates and
-- reserves those binders, Book.alloc of the Feature constructors
-- must mint distinct spellings (rk0-3, not a second rk0-2).
import "../../examples/cshrl/std/nat.muro"
import "../../examples/cshrl/lib/agent.muro"

data Flag : Type where
  off : Flag
  lit : Flag
  dead : Flag

data State : Type where
  spot : Π (flag : Flag) → State

data Action : Type where
  j : Action
  s : Action

data Feature : Type where
  rk0 : Feature
  k0 : Feature
  f0_0 : Feature

def eval-feature : run Π (+ f : Feature) → Π (+ st : State) → Bool :=
  λ (+ f : Feature) → λ (+ st : State) →
    match f motive (λ _ → Bool)
      | rk0 => false
      | k0 => false
      | f0_0 => false

def Reward : spec Type := Nat

def step : run Π (st : State) → Π (actn : Action) → State × Reward :=
  λ (st : State) → λ (actn : Action) →
    match st motive (λ _ → State × Reward)
      | spot flag =>
          (match flag motive (λ _ → State × Reward)
            | off => (spot lit, 0)
            | lit => (spot lit, suc 0)
            | dead => (spot dead, 0))

def le : spec Π (rw : Reward) → Π (qv : Reward) → Type := Le
def max : run Π (rw : Reward) → Π (qv : Reward) → Reward := maxN
def bottom : run Reward := 0
def all-actions : run List Action := cons j (cons s nil)
def default-action : run Action := j
def horizon : run Nat := suc (suc 0)
def all-states : run List State :=
  cons (spot off) (cons (spot lit) (cons (spot dead) nil))
