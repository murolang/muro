-- talk.muro — one description, and each party has a session.
-- The description is spec. A run definition has no seat.

talk ping-exchange := say peer pong Nat (say pong peer Nat over)

session ping := seen pong with peer in ping-exchange

session back := seen peer with pong in ping-exchange

conform pong : ping := get Nat (put 1 done)

conform peer : back := put 1 (get Nat done)

meet wire : pong with peer

talk both-arms := offer a b (say b c Nat over) (say b c Nat over)

session ab := seen a with b in both-arms

session bc := seen b with c in both-arms

session ac := seen a with c in both-arms

talk arm := offer a b over (say a b Nat over)

session choice := seen a with b in arm

session offered := seen b with a in arm

conform taker : choice := pick0 done

conform giver : offered := cover done (get Nat done)

def kept : run Nat := 0
