-- lam.muro — substitution graphs as one environment.
--
-- The states are the terms reachable from copy2, copy4, copy8, the
-- one-use and discarding programs, and len-one, by either substitution.
-- Each step is one substitution. done is a stopped head: it pays 1
-- forever. Every earlier step pays 0. The steps until the head stops
-- are the leading zeros of the return.
--
-- policy takes arg at copy, copy4, and copy8, where that call would be
-- copied. It takes the spine call everywhere else. At len the argument's
-- call is not the one being copied, and taking it adds a step, so the
-- spine call stays first.
import "../std/nat.muro"
import "../lib/successor.muro"
import "../lib/agent.muro"

data State : Type where
  copy : State
  copy4 : State
  copy8 : State
  ready : State
  ready4 : State
  ready8 : State
  len : State
  affine : State
  discard : State
  drop : State
  w0 : State
  w1 : State
  w10 : State
  w11 : State
  w12 : State
  w13 : State
  w14 : State
  w15 : State
  w16 : State
  w17 : State
  w18 : State
  w19 : State
  w2 : State
  w20 : State
  w21 : State
  w22 : State
  w23 : State
  w24 : State
  w25 : State
  w26 : State
  w27 : State
  w28 : State
  w29 : State
  w3 : State
  w30 : State
  w31 : State
  w32 : State
  w33 : State
  w34 : State
  w35 : State
  w36 : State
  w37 : State
  w38 : State
  w39 : State
  w4 : State
  w40 : State
  w41 : State
  w42 : State
  w43 : State
  w44 : State
  w45 : State
  w46 : State
  w5 : State
  w6 : State
  w7 : State
  w8 : State
  w9 : State
  done : State

data Action : Type where
  arg   : Action
  spine : Action

def Reward : spec Type := Nat

def step : run Π (s : State) → Π (a : Action) → State × Reward :=
  λ (s : State) → λ (a : Action) →
    match s motive (λ _ → State × Reward)
      | copy =>
          (match a motive (λ _ → State × Reward) | arg => (ready, 0) | spine => (w10, 0))
      | copy4 =>
          (match a motive (λ _ → State × Reward) | arg => (ready4, 0) | spine => (w23, 0))
      | copy8 =>
          (match a motive (λ _ → State × Reward) | arg => (ready8, 0) | spine => (w8, 0))
      | ready => (w12, 0)
      | ready4 => (w2, 0)
      | ready8 => (w37, 0)
      | len =>
          (match a motive (λ _ → State × Reward) | arg => (w3, 0) | spine => (w45, 0))
      | affine =>
          (match a motive (λ _ → State × Reward) | arg => (w20, 0) | spine => (w4, 0))
      | discard =>
          (match a motive (λ _ → State × Reward) | arg => (w29, 0) | spine => (done, 0))
      | drop =>
          (match a motive (λ _ → State × Reward) | arg => (w22, 0) | spine => (done, 0))
      | w0 => (w28, 0)
      | w1 => (done, 0)
      | w10 => (w11, 0)
      | w11 =>
          (match a motive (λ _ → State × Reward) | arg => (w12, 0) | spine => (w4, 0))
      | w12 => (w43, 0)
      | w13 => (w7, 0)
      | w14 => (w24, 0)
      | w15 =>
          (match a motive (λ _ → State × Reward) | arg => (w39, 0) | spine => (w31, 0))
      | w16 =>
          (match a motive (λ _ → State × Reward) | arg => (w6, 0) | spine => (done, 0))
      | w17 => (w26, 0)
      | w18 =>
          (match a motive (λ _ → State × Reward) | arg => (w9, 0) | spine => (w25, 0))
      | w19 =>
          (match a motive (λ _ → State × Reward) | arg => (w1, 0) | spine => (done, 0))
      | w2 => (w38, 0)
      | w20 => (w43, 0)
      | w21 =>
          (match a motive (λ _ → State × Reward) | arg => (w27, 0) | spine => (done, 0))
      | w22 => (done, 0)
      | w23 => (w24, 0)
      | w24 =>
          (match a motive (λ _ → State × Reward) | arg => (w32, 0) | spine => (w17, 0))
      | w25 => (w15, 0)
      | w26 =>
          (match a motive (λ _ → State × Reward) | arg => (w33, 0) | spine => (w10, 0))
      | w27 => (done, 0)
      | w28 => (w5, 0)
      | w29 => (done, 0)
      | w3 => (w30, 0)
      | w30 =>
          (match a motive (λ _ → State × Reward) | arg => (w44, 0) | spine => (w19, 0))
      | w31 => (w36, 0)
      | w32 => (w26, 0)
      | w33 => (w11, 0)
      | w34 =>
          (match a motive (λ _ → State × Reward) | arg => (w35, 0) | spine => (w42, 0))
      | w35 => (w40, 0)
      | w36 =>
          (match a motive (λ _ → State × Reward) | arg => (w46, 0) | spine => (w13, 0))
      | w37 => (w0, 0)
      | w38 => (w12, 0)
      | w39 => (w36, 0)
      | w4 => (w43, 0)
      | w40 =>
          (match a motive (λ _ → State × Reward) | arg => (w21, 0) | spine => (done, 0))
      | w41 =>
          (match a motive (λ _ → State × Reward) | arg => (w16, 0) | spine => (done, 0))
      | w42 =>
          (match a motive (λ _ → State × Reward) | arg => (w19, 0) | spine => (done, 0))
      | w43 => (done, 0)
      | w44 => (w21, 0)
      | w45 =>
          (match a motive (λ _ → State × Reward) | arg => (w34, 0) | spine => (w41, 0))
      | w46 => (w7, 0)
      | w5 => (w2, 0)
      | w6 => (done, 0)
      | w7 =>
          (match a motive (λ _ → State × Reward) | arg => (w14, 0) | spine => (w23, 0))
      | w8 => (w18, 0)
      | w9 => (w15, 0)
      | done => (done, suc 0)

def le : spec Π (r : Reward) → Π (q : Reward) → Type := Le
def max : run Π (r : Reward) → Π (q : Reward) → Reward := maxN
def bottom : run Reward := 0
def all-actions : run List Action := cons arg (cons spine nil)
def default-action : run Action := spine
def horizon : run Nat := suc (suc (suc (suc (suc 0))))

def pay : run Π (n : Nat) → Π (d : Nat) → Nat :=
  λ (n : Nat) → λ (d : Nat) →
    match d motive (λ _ → Nat)
      | 0 => suc 0
      | suc d1 =>
          (match n motive (λ _ → Nat)
            | 0 => 0
            | suc n1 => pay n1 d1)

def dist : run Π (s : State) → Nat :=
  λ (s : State) →
    match s motive (λ _ → Nat)
      | copy => suc (suc (suc (suc (0))))
      | copy4 => suc (suc (suc (suc (suc (suc (0))))))
      | copy8 => suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (0))))))))))
      | ready => suc (suc (suc (0)))
      | ready4 => suc (suc (suc (suc (suc (0)))))
      | ready8 => suc (suc (suc (suc (suc (suc (suc (suc (suc (0)))))))))
      | len => suc (suc (suc (0)))
      | affine => suc (suc (suc (0)))
      | discard => suc (0)
      | drop => suc (0)
      | w0 => suc (suc (suc (suc (suc (suc (suc (0)))))))
      | w1 => suc (0)
      | w10 => suc (suc (suc (suc (0))))
      | w11 => suc (suc (suc (0)))
      | w12 => suc (suc (0))
      | w13 => suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (0))))))))))
      | w14 => suc (suc (suc (suc (suc (suc (suc (suc (0))))))))
      | w15 => suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (0)))))))))))))
      | w16 => suc (0)
      | w17 => suc (suc (suc (suc (suc (suc (0))))))
      | w18 => suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (0)))))))))))))))
      | w19 => suc (0)
      | w2 => suc (suc (suc (suc (0))))
      | w20 => suc (suc (0))
      | w21 => suc (0)
      | w22 => suc (0)
      | w23 => suc (suc (suc (suc (suc (suc (suc (suc (0))))))))
      | w24 => suc (suc (suc (suc (suc (suc (suc (0)))))))
      | w25 => suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (0))))))))))))))
      | w26 => suc (suc (suc (suc (suc (0)))))
      | w27 => suc (0)
      | w28 => suc (suc (suc (suc (suc (suc (0))))))
      | w29 => suc (0)
      | w3 => suc (suc (suc (0)))
      | w30 => suc (suc (0))
      | w31 => suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (0))))))))))))
      | w32 => suc (suc (suc (suc (suc (suc (0))))))
      | w33 => suc (suc (suc (suc (0))))
      | w34 => suc (suc (0))
      | w35 => suc (suc (0))
      | w36 => suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (0)))))))))))
      | w37 => suc (suc (suc (suc (suc (suc (suc (suc (0))))))))
      | w38 => suc (suc (suc (0)))
      | w39 => suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (0))))))))))))
      | w4 => suc (suc (0))
      | w40 => suc (0)
      | w41 => suc (0)
      | w42 => suc (0)
      | w43 => suc (0)
      | w44 => suc (suc (0))
      | w45 => suc (suc (0))
      | w46 => suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (0))))))))))
      | w5 => suc (suc (suc (suc (suc (0)))))
      | w6 => suc (0)
      | w7 => suc (suc (suc (suc (suc (suc (suc (suc (suc (0)))))))))
      | w8 => suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (0))))))))))))))))
      | w9 => suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (suc (0))))))))))))))
      | done => 0

def max-refl : evidence Π (n : Nat) → {maxN n n ≡ n : Nat} :=
  λ (n : Nat) →
    match n motive (λ (k : Nat) → {maxN k k ≡ k : Nat})
      | 0 => refl
      | suc p => rewrite max-refl p motive (λ z → {suc z ≡ suc p : Nat}) in refl

def max-same : evidence Π (n : Nat) → {maxN n (maxN n 0) ≡ n : Nat} :=
  λ (n : Nat) →
    match n motive (λ (k : Nat) → {maxN k (maxN k 0) ≡ k : Nat})
      | 0 => refl
      | suc p => rewrite max-refl p motive (λ z → {suc z ≡ suc p : Nat}) in refl

def max-zero : evidence Π (n : Nat) → {maxN n 0 ≡ n : Nat} :=
  λ (n : Nat) →
    match n motive (λ (k : Nat) → {maxN k 0 ≡ k : Nat})
      | 0 => refl
      | suc _ => refl

-- maxN x y is x when y is below x.
def max-ge : evidence Π (x : Nat) → Π (y : Nat) → Π (yx : Le y x) → {maxN x y ≡ x : Nat} :=
  λ (x : Nat) → λ (y : Nat) → λ (yx : Le y x) →
    (match x motive (λ (a : Nat) → Π (b : Nat) → Π (ba : Le b a) → {maxN a b ≡ a : Nat})
      | 0 =>
          (λ (b : Nat) →
            match b motive (λ (c : Nat) → Π (ca : Le c 0) → {maxN 0 c ≡ 0 : Nat})
              | 0 => λ (_ : Unit) → refl
              | suc q => λ (ca : Empty) → matchEmpty ca motive (λ _ → {maxN 0 (suc q) ≡ 0 : Nat}))
      | suc p =>
          (λ (b : Nat) →
            match b motive (λ (c : Nat) → Π (ca : Le c (suc p)) → {maxN (suc p) c ≡ suc p : Nat})
              | 0 => λ (_ : Unit) → refl
              | suc q => λ (ca : Le q p) →
                  rewrite max-ge p q ca motive (λ z → {suc z ≡ suc p : Nat}) in refl))
    y yx

-- maxN x y is y when x is below y.
def max-ge-right : evidence Π (x : Nat) → Π (y : Nat) → Π (xy : Le x y) → {maxN x y ≡ y : Nat} :=
  λ (x : Nat) → λ (y : Nat) → λ (xy : Le x y) →
    (match y motive (λ (b : Nat) → Π (a : Nat) → Π (ab : Le a b) → {maxN a b ≡ b : Nat})
      | 0 =>
          (λ (a : Nat) →
            match a motive (λ (c : Nat) → Π (ca : Le c 0) → {maxN c 0 ≡ 0 : Nat})
              | 0 => λ (_ : Unit) → refl
              | suc q => λ (ca : Empty) → matchEmpty ca motive (λ _ → {maxN (suc q) 0 ≡ 0 : Nat}))
      | suc q =>
          (λ (a : Nat) →
            match a motive (λ (c : Nat) → Π (ca : Le c (suc q)) → {maxN c (suc q) ≡ suc q : Nat})
              | 0 => λ (_ : Unit) → refl
              | suc p => λ (ca : Le p q) →
                  rewrite max-ge-right p q ca motive (λ z → {suc z ≡ suc q : Nat}) in refl))
    x xy

def pay-later : evidence Π (n : Nat) → Π (d : Nat) → Le (pay n (suc d)) (pay n d) :=
  λ (n : Nat) → λ (d : Nat) →
    match d motive (λ (e : Nat) → Le (pay n (suc e)) (pay n e))
      | 0 =>
          (match n motive (λ (k : Nat) → Le (pay k (suc 0)) (pay k 0))
            | 0 => tt
            | suc _ => tt)
      | suc d1 =>
          (match n motive (λ (k : Nat) → Le (pay k (suc (suc d1))) (pay k (suc d1)))
            | 0 => tt
            | suc p => pay-later p d1)

def pay-le : evidence Π (n : Nat) → Π (d : Nat) → Π (k : Nat) → Le (pay n (plus k d)) (pay n d) :=
  λ (n : Nat) → λ (d : Nat) → λ (k : Nat) →
    match k motive (λ (j : Nat) → Le (pay n (plus j d)) (pay n d))
      | 0 => le-refl (pay n d)
      | suc k1 =>
          le-trans (pay n (plus (suc k1) d)) (pay n (plus k1 d)) (pay n d)
            (pay-later n (plus k1 d)) (pay-le n d k1)

def solve-is : evidence Π (n : Nat) → Π (s : State) → {solve s n ≡ pay n (dist s) : Nat} :=
  λ (n : Nat) → λ (s : State) →
    match s motive (λ (x : State) → {solve x n ≡ pay n (dist x) : Nat})
      | copy =>
          (match n motive (λ (k : Nat) → {solve copy k ≡ pay k (dist copy) : Nat})
            | 0 => refl
            | suc m =>
                rewrite solve-is m ready motive (λ z → {maxN z (maxN (solve w10 m) 0) ≡ pay (suc m) (dist copy) : Nat}) in
                rewrite solve-is m w10 motive (λ w → {maxN (pay m (dist ready)) (maxN w 0) ≡ pay (suc m) (dist copy) : Nat}) in
                rewrite max-zero (pay m (dist w10)) motive (λ y → {maxN (pay m (dist ready)) y ≡ pay (suc m) (dist copy) : Nat}) in
                rewrite max-ge (pay m (dist ready)) (pay m (dist w10)) (pay-le m (dist ready) suc (0)) motive (λ z → {z ≡ pay (suc m) (dist copy) : Nat}) in
                refl)
      | copy4 =>
          (match n motive (λ (k : Nat) → {solve copy4 k ≡ pay k (dist copy4) : Nat})
            | 0 => refl
            | suc m =>
                rewrite solve-is m ready4 motive (λ z → {maxN z (maxN (solve w23 m) 0) ≡ pay (suc m) (dist copy4) : Nat}) in
                rewrite solve-is m w23 motive (λ w → {maxN (pay m (dist ready4)) (maxN w 0) ≡ pay (suc m) (dist copy4) : Nat}) in
                rewrite max-zero (pay m (dist w23)) motive (λ y → {maxN (pay m (dist ready4)) y ≡ pay (suc m) (dist copy4) : Nat}) in
                rewrite max-ge (pay m (dist ready4)) (pay m (dist w23)) (pay-le m (dist ready4) suc (suc (suc (0)))) motive (λ z → {z ≡ pay (suc m) (dist copy4) : Nat}) in
                refl)
      | copy8 =>
          (match n motive (λ (k : Nat) → {solve copy8 k ≡ pay k (dist copy8) : Nat})
            | 0 => refl
            | suc m =>
                rewrite solve-is m ready8 motive (λ z → {maxN z (maxN (solve w8 m) 0) ≡ pay (suc m) (dist copy8) : Nat}) in
                rewrite solve-is m w8 motive (λ w → {maxN (pay m (dist ready8)) (maxN w 0) ≡ pay (suc m) (dist copy8) : Nat}) in
                rewrite max-zero (pay m (dist w8)) motive (λ y → {maxN (pay m (dist ready8)) y ≡ pay (suc m) (dist copy8) : Nat}) in
                rewrite max-ge (pay m (dist ready8)) (pay m (dist w8)) (pay-le m (dist ready8) suc (suc (suc (suc (suc (suc (suc (0)))))))) motive (λ z → {z ≡ pay (suc m) (dist copy8) : Nat}) in
                refl)
      | ready =>
          (match n motive (λ (k : Nat) → {solve ready k ≡ pay k (dist ready) : Nat})
            | 0 => refl
            | suc m =>
                rewrite solve-is m w12 motive (λ z → {maxN z (maxN z 0) ≡ pay (suc m) (dist ready) : Nat}) in
                rewrite max-same (pay m (dist w12)) motive (λ z → {z ≡ pay (suc m) (dist ready) : Nat}) in
                refl)
      | ready4 =>
          (match n motive (λ (k : Nat) → {solve ready4 k ≡ pay k (dist ready4) : Nat})
            | 0 => refl
            | suc m =>
                rewrite solve-is m w2 motive (λ z → {maxN z (maxN z 0) ≡ pay (suc m) (dist ready4) : Nat}) in
                rewrite max-same (pay m (dist w2)) motive (λ z → {z ≡ pay (suc m) (dist ready4) : Nat}) in
                refl)
      | ready8 =>
          (match n motive (λ (k : Nat) → {solve ready8 k ≡ pay k (dist ready8) : Nat})
            | 0 => refl
            | suc m =>
                rewrite solve-is m w37 motive (λ z → {maxN z (maxN z 0) ≡ pay (suc m) (dist ready8) : Nat}) in
                rewrite max-same (pay m (dist w37)) motive (λ z → {z ≡ pay (suc m) (dist ready8) : Nat}) in
                refl)
      | len =>
          (match n motive (λ (k : Nat) → {solve len k ≡ pay k (dist len) : Nat})
            | 0 => refl
            | suc m =>
                rewrite solve-is m w3 motive (λ z → {maxN z (maxN (solve w45 m) 0) ≡ pay (suc m) (dist len) : Nat}) in
                rewrite solve-is m w45 motive (λ w → {maxN (pay m (dist w3)) (maxN w 0) ≡ pay (suc m) (dist len) : Nat}) in
                rewrite max-zero (pay m (dist w45)) motive (λ y → {maxN (pay m (dist w3)) y ≡ pay (suc m) (dist len) : Nat}) in
                rewrite max-ge-right (pay m (dist w3)) (pay m (dist w45)) (pay-le m (dist w45) suc (0)) motive (λ z → {z ≡ pay (suc m) (dist len) : Nat}) in
                refl)
      | affine =>
          (match n motive (λ (k : Nat) → {solve affine k ≡ pay k (dist affine) : Nat})
            | 0 => refl
            | suc m =>
                rewrite solve-is m w20 motive (λ z → {maxN z (maxN (solve w4 m) 0) ≡ pay (suc m) (dist affine) : Nat}) in
                rewrite solve-is m w4 motive (λ w → {maxN (pay m (dist w20)) (maxN w 0) ≡ pay (suc m) (dist affine) : Nat}) in
                rewrite max-zero (pay m (dist w4)) motive (λ y → {maxN (pay m (dist w20)) y ≡ pay (suc m) (dist affine) : Nat}) in
                rewrite max-refl (pay m (dist w20)) motive (λ z → {z ≡ pay (suc m) (dist affine) : Nat}) in
                refl)
      | discard =>
          (match n motive (λ (k : Nat) → {solve discard k ≡ pay k (dist discard) : Nat})
            | 0 => refl
            | suc m =>
                rewrite solve-is m w29 motive (λ z → {maxN z (maxN (solve done m) 0) ≡ pay (suc m) (dist discard) : Nat}) in
                rewrite solve-is m done motive (λ w → {maxN (pay m (dist w29)) (maxN w 0) ≡ pay (suc m) (dist discard) : Nat}) in
                rewrite max-zero (pay m (dist done)) motive (λ y → {maxN (pay m (dist w29)) y ≡ pay (suc m) (dist discard) : Nat}) in
                rewrite max-ge-right (pay m (dist w29)) (pay m (dist done)) (pay-le m (dist done) suc (0)) motive (λ z → {z ≡ pay (suc m) (dist discard) : Nat}) in
                refl)
      | drop =>
          (match n motive (λ (k : Nat) → {solve drop k ≡ pay k (dist drop) : Nat})
            | 0 => refl
            | suc m =>
                rewrite solve-is m w22 motive (λ z → {maxN z (maxN (solve done m) 0) ≡ pay (suc m) (dist drop) : Nat}) in
                rewrite solve-is m done motive (λ w → {maxN (pay m (dist w22)) (maxN w 0) ≡ pay (suc m) (dist drop) : Nat}) in
                rewrite max-zero (pay m (dist done)) motive (λ y → {maxN (pay m (dist w22)) y ≡ pay (suc m) (dist drop) : Nat}) in
                rewrite max-ge-right (pay m (dist w22)) (pay m (dist done)) (pay-le m (dist done) suc (0)) motive (λ z → {z ≡ pay (suc m) (dist drop) : Nat}) in
                refl)
      | w0 =>
          (match n motive (λ (k : Nat) → {solve w0 k ≡ pay k (dist w0) : Nat})
            | 0 => refl
            | suc m =>
                rewrite solve-is m w28 motive (λ z → {maxN z (maxN z 0) ≡ pay (suc m) (dist w0) : Nat}) in
                rewrite max-same (pay m (dist w28)) motive (λ z → {z ≡ pay (suc m) (dist w0) : Nat}) in
                refl)
      | w1 =>
          (match n motive (λ (k : Nat) → {solve w1 k ≡ pay k (dist w1) : Nat})
            | 0 => refl
            | suc m =>
                rewrite solve-is m done motive (λ z → {maxN z (maxN z 0) ≡ pay (suc m) (dist w1) : Nat}) in
                rewrite max-same (pay m (dist done)) motive (λ z → {z ≡ pay (suc m) (dist w1) : Nat}) in
                refl)
      | w10 =>
          (match n motive (λ (k : Nat) → {solve w10 k ≡ pay k (dist w10) : Nat})
            | 0 => refl
            | suc m =>
                rewrite solve-is m w11 motive (λ z → {maxN z (maxN z 0) ≡ pay (suc m) (dist w10) : Nat}) in
                rewrite max-same (pay m (dist w11)) motive (λ z → {z ≡ pay (suc m) (dist w10) : Nat}) in
                refl)
      | w11 =>
          (match n motive (λ (k : Nat) → {solve w11 k ≡ pay k (dist w11) : Nat})
            | 0 => refl
            | suc m =>
                rewrite solve-is m w12 motive (λ z → {maxN z (maxN (solve w4 m) 0) ≡ pay (suc m) (dist w11) : Nat}) in
                rewrite solve-is m w4 motive (λ w → {maxN (pay m (dist w12)) (maxN w 0) ≡ pay (suc m) (dist w11) : Nat}) in
                rewrite max-zero (pay m (dist w4)) motive (λ y → {maxN (pay m (dist w12)) y ≡ pay (suc m) (dist w11) : Nat}) in
                rewrite max-refl (pay m (dist w12)) motive (λ z → {z ≡ pay (suc m) (dist w11) : Nat}) in
                refl)
      | w12 =>
          (match n motive (λ (k : Nat) → {solve w12 k ≡ pay k (dist w12) : Nat})
            | 0 => refl
            | suc m =>
                rewrite solve-is m w43 motive (λ z → {maxN z (maxN z 0) ≡ pay (suc m) (dist w12) : Nat}) in
                rewrite max-same (pay m (dist w43)) motive (λ z → {z ≡ pay (suc m) (dist w12) : Nat}) in
                refl)
      | w13 =>
          (match n motive (λ (k : Nat) → {solve w13 k ≡ pay k (dist w13) : Nat})
            | 0 => refl
            | suc m =>
                rewrite solve-is m w7 motive (λ z → {maxN z (maxN z 0) ≡ pay (suc m) (dist w13) : Nat}) in
                rewrite max-same (pay m (dist w7)) motive (λ z → {z ≡ pay (suc m) (dist w13) : Nat}) in
                refl)
      | w14 =>
          (match n motive (λ (k : Nat) → {solve w14 k ≡ pay k (dist w14) : Nat})
