      | w44 => spine
      | w45 => spine
      | w46 => spine
      | w5 => spine
      | w6 => spine
      | w7 => spine
      | w8 => spine
      | w9 => spine
      | done => spine

def agent : run Π (s : State) → Stream (Action × Reward) :=
  λ (s : State) → episode-with policy s

def successor-at-copy : evidence {find-successor-policy copy horizon ≡ arg : Action} := refl
