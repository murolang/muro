def ranking : spec Π (s : State) → Π (a : Action) → Π (b : Action) → Type :=
  λ (s : State) → λ (a : Action) → λ (b : Action) →
    match s motive (λ _ → Type)
      | copy =>
          (match a motive (λ _ → Type)
            | arg => (match b motive (λ _ → Type) | arg => Unit | spine => Empty)
            | spine => Unit)
      | copy4 =>
          (match a motive (λ _ → Type)
            | arg => (match b motive (λ _ → Type) | arg => Unit | spine => Empty)
            | spine => Unit)
      | copy8 =>
          (match a motive (λ _ → Type)
            | arg => (match b motive (λ _ → Type) | arg => Unit | spine => Empty)
            | spine => Unit)
      | ready => Unit
      | ready4 => Unit
      | ready8 => Unit
      | len =>
          (match a motive (λ _ → Type)
            | arg => Unit
            | spine => (match b motive (λ _ → Type) | arg => Empty | spine => Unit))
      | affine => Unit
      | discard =>
          (match a motive (λ _ → Type)
            | arg => Unit
            | spine => (match b motive (λ _ → Type) | arg => Empty | spine => Unit))
      | drop =>
          (match a motive (λ _ → Type)
            | arg => Unit
            | spine => (match b motive (λ _ → Type) | arg => Empty | spine => Unit))
      | w0 => Unit
      | w1 => Unit
      | w10 => Unit
      | w11 => Unit
      | w12 => Unit
      | w13 => Unit
      | w14 => Unit
      | w15 => Unit
      | w16 =>
          (match a motive (λ _ → Type)
            | arg => Unit
            | spine => (match b motive (λ _ → Type) | arg => Empty | spine => Unit))
      | w17 => Unit
      | w18 => Unit
      | w19 =>
          (match a motive (λ _ → Type)
            | arg => Unit
            | spine => (match b motive (λ _ → Type) | arg => Empty | spine => Unit))
      | w2 => Unit
      | w20 => Unit
      | w21 =>
          (match a motive (λ _ → Type)
            | arg => Unit
            | spine => (match b motive (λ _ → Type) | arg => Empty | spine => Unit))
      | w22 => Unit
      | w23 => Unit
      | w24 => Unit
      | w25 => Unit
      | w26 => Unit
      | w27 => Unit
      | w28 => Unit
      | w29 => Unit
      | w3 => Unit
      | w30 =>
          (match a motive (λ _ → Type)
            | arg => Unit
            | spine => (match b motive (λ _ → Type) | arg => Empty | spine => Unit))
      | w31 => Unit
      | w32 => Unit
      | w33 => Unit
      | w34 =>
          (match a motive (λ _ → Type)
            | arg => Unit
            | spine => (match b motive (λ _ → Type) | arg => Empty | spine => Unit))
      | w35 => Unit
      | w36 => Unit
      | w37 => Unit
      | w38 => Unit
      | w39 => Unit
      | w4 => Unit
      | w40 =>
          (match a motive (λ _ → Type)
            | arg => Unit
            | spine => (match b motive (λ _ → Type) | arg => Empty | spine => Unit))
      | w41 =>
          (match a motive (λ _ → Type)
            | arg => Unit
            | spine => (match b motive (λ _ → Type) | arg => Empty | spine => Unit))
      | w42 =>
          (match a motive (λ _ → Type)
            | arg => Unit
            | spine => (match b motive (λ _ → Type) | arg => Empty | spine => Unit))
      | w43 => Unit
      | w44 => Unit
      | w45 =>
          (match a motive (λ _ → Type)
            | arg => Unit
            | spine => (match b motive (λ _ → Type) | arg => Empty | spine => Unit))
      | w46 => Unit
      | w5 => Unit
      | w6 => Unit
      | w7 => Unit
      | w8 => Unit
      | w9 => Unit
      | done => Unit

def lam-homomorphism : evidence CoinductiveHomomorphism ranking :=
  λ (a : Action) → λ (b : Action) → λ (s : State) →
    match s motive (λ (x : State) → Π (r : ranking x a b) → Dom Reward le (successor-value x a) (successor-value x b))
      | copy =>
          (match a motive (λ (y : Action) → Π (r : ranking copy y b) → Dom Reward le (successor-value copy y) (successor-value copy b))
            | arg =>
                (match b motive (λ (z : Action) → Π (r : ranking copy arg z) → Dom Reward le (value ready) (successor-value copy z))
                  | arg => λ (_ : Unit) → dom-refl Reward le le-refl (value ready)
                  | spine => λ (r : Empty) → matchEmpty r motive (λ _ → Dom Reward le (value ready) (value w10)))
            | spine =>
                (match b motive (λ (z : Action) → Π (r : ranking copy spine z) → Dom Reward le (value w10) (successor-value copy z))
                  | arg => λ (_ : Unit) → dom-w10-ready
                  | spine => λ (_ : Unit) → dom-refl Reward le le-refl (value w10)))
      | copy4 =>
          (match a motive (λ (y : Action) → Π (r : ranking copy4 y b) → Dom Reward le (successor-value copy4 y) (successor-value copy4 b))
            | arg =>
                (match b motive (λ (z : Action) → Π (r : ranking copy4 arg z) → Dom Reward le (value ready4) (successor-value copy4 z))
                  | arg => λ (_ : Unit) → dom-refl Reward le le-refl (value ready4)
                  | spine => λ (r : Empty) → matchEmpty r motive (λ _ → Dom Reward le (value ready4) (value w23)))
            | spine =>
                (match b motive (λ (z : Action) → Π (r : ranking copy4 spine z) → Dom Reward le (value w23) (successor-value copy4 z))
                  | arg => λ (_ : Unit) → dom-w23-ready4
                  | spine => λ (_ : Unit) → dom-refl Reward le le-refl (value w23)))
      | copy8 =>
          (match a motive (λ (y : Action) → Π (r : ranking copy8 y b) → Dom Reward le (successor-value copy8 y) (successor-value copy8 b))
            | arg =>
                (match b motive (λ (z : Action) → Π (r : ranking copy8 arg z) → Dom Reward le (value ready8) (successor-value copy8 z))
                  | arg => λ (_ : Unit) → dom-refl Reward le le-refl (value ready8)
                  | spine => λ (r : Empty) → matchEmpty r motive (λ _ → Dom Reward le (value ready8) (value w8)))
            | spine =>
                (match b motive (λ (z : Action) → Π (r : ranking copy8 spine z) → Dom Reward le (value w8) (successor-value copy8 z))
                  | arg => λ (_ : Unit) → dom-w8-ready8
                  | spine => λ (_ : Unit) → dom-refl Reward le le-refl (value w8)))
      | ready => λ (_ : Unit) → dom-refl Reward le le-refl (value w12)
      | ready4 => λ (_ : Unit) → dom-refl Reward le le-refl (value w2)
      | ready8 => λ (_ : Unit) → dom-refl Reward le le-refl (value w37)
      | len =>
          (match a motive (λ (y : Action) → Π (r : ranking len y b) → Dom Reward le (successor-value len y) (successor-value len b))
            | arg =>
                (match b motive (λ (z : Action) → Π (r : ranking len arg z) → Dom Reward le (value w3) (successor-value len z))
                  | arg => λ (_ : Unit) → dom-refl Reward le le-refl (value w3)
                  | spine => λ (_ : Unit) → dom-w3-w45)
            | spine =>
