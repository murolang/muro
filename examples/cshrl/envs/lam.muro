def lam-coind : evidence CoindHomo ranking :=
  successor-head-coindHomo ranking lam-homomorphism lam-heads

def policy : run Π (s : State) → Action :=
  λ (s : State) →
    match s motive (λ _ → Action)
      | copy => arg
      | copy4 => arg
      | copy8 => arg
      | ready => spine
      | ready4 => spine
      | ready8 => spine
      | len => spine
      | affine => spine
      | discard => spine
      | drop => spine
      | w0 => spine
