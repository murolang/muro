def dom-w10-ready : evidence Dom Reward le (value w10) (value ready) :=
  tabulate-dom Reward le (λ (n : Nat) → solve w10 n) (λ (n : Nat) → solve ready n)
    (λ (n : Nat) →
      rewrite solve-is n w10 motive (λ z → Le z (solve ready n)) in
      rewrite solve-is n ready motive (λ z → Le (pay n (dist w10)) z) in
      pay-le n (dist ready) suc (0))
    0

def dom-w23-ready4 : evidence Dom Reward le (value w23) (value ready4) :=
  tabulate-dom Reward le (λ (n : Nat) → solve w23 n) (λ (n : Nat) → solve ready4 n)
    (λ (n : Nat) →
      rewrite solve-is n w23 motive (λ z → Le z (solve ready4 n)) in
      rewrite solve-is n ready4 motive (λ z → Le (pay n (dist w23)) z) in
      pay-le n (dist ready4) suc (suc (suc (0))))
    0

def dom-w8-ready8 : evidence Dom Reward le (value w8) (value ready8) :=
  tabulate-dom Reward le (λ (n : Nat) → solve w8 n) (λ (n : Nat) → solve ready8 n)
    (λ (n : Nat) →
      rewrite solve-is n w8 motive (λ z → Le z (solve ready8 n)) in
      rewrite solve-is n ready8 motive (λ z → Le (pay n (dist w8)) z) in
      pay-le n (dist ready8) suc (suc (suc (suc (suc (suc (suc (0))))))))
    0

