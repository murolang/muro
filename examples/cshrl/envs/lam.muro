def lam-heads : evidence HeadCompatible ranking :=
  λ (a : Action) → λ (b : Action) → λ (s : State) → λ (_ : ranking s a b) →
    match s motive (λ (x : State) → Le (snd (step x a)) (snd (step x b)))
      | copy =>
          (match a motive (λ (y : Action) → Le (snd (step copy y)) (snd (step copy b)))
            | arg => (match b motive (λ (z : Action) → Le 0 (snd (step copy z))) | arg => tt | spine => tt)
            | spine => (match b motive (λ (z : Action) → Le 0 (snd (step copy z))) | arg => tt | spine => tt))
      | copy4 =>
          (match a motive (λ (y : Action) → Le (snd (step copy4 y)) (snd (step copy4 b)))
