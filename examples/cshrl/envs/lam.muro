-- lam.muro — a finite substitution graph.
--
-- copy, copy4, and copy8 are (λ (+ f) → f (f … (λ n → n))) applied to
-- the redex (λ h → h) (λ g → g). That argument's λ is affine, and f
-- is used more than once, so contracting the redex before the copy is
-- the shorter trace. len is measure (length Nat): m is also used
-- twice and the argument is also a call, but length's binder is
-- erased (- A). Contracting that instantiation adds a step. spine
-- is shorter there.
--
-- Each inst pays 0. done pays 1 forever. This book declares no feature.
import "../std/nat.muro"
import "../lib/agent.muro"

data State : Type where
  copy   : State
  copy4  : State
  copy8  : State
  len    : State
  ready  : State
  ready4 : State
  ready8 : State
  done   : State
  cold   : State
  wlen   : State

data Action : Type where
  arg   : Action
  spine : Action

def Reward : spec Type := Nat

def step : run Π (s : State) → Π (a : Action) → State × Reward :=
  λ (s : State) → λ (a : Action) →
    match s motive (λ _ → State × Reward)
      | copy =>
          (match a motive (λ _ → State × Reward)
            | arg => (done, 0)
            | spine => (cold, 0))
      | copy4 =>
          (match a motive (λ _ → State × Reward)
            | arg => (done, 0)
            | spine => (cold, 0))
      | copy8 =>
          (match a motive (λ _ → State × Reward)
            | arg => (done, 0)
            | spine => (cold, 0))
      | len =>
          (match a motive (λ _ → State × Reward)
            | arg => (wlen, 0)
            | spine => (done, 0))
      | ready =>
          (match a motive (λ _ → State × Reward)
            | arg => (done, suc 0)
            | spine => (done, suc 0))
      | ready4 =>
          (match a motive (λ _ → State × Reward)
            | arg => (done, suc 0)
            | spine => (done, suc 0))
      | ready8 =>
          (match a motive (λ _ → State × Reward)
            | arg => (done, suc 0)
            | spine => (done, suc 0))
      | done =>
          (match a motive (λ _ → State × Reward)
            | arg => (done, suc 0)
            | spine => (done, suc 0))
      | cold =>
          (match a motive (λ _ → State × Reward)
            | arg => (cold, 0)
            | spine => (cold, 0))
      | wlen =>
          (match a motive (λ _ → State × Reward)
            | arg => (wlen, 0)
            | spine => (wlen, 0))

def le : spec Π (r : Reward) → Π (q : Reward) → Type := Le
def max : run Π (r : Reward) → Π (q : Reward) → Reward := maxN
def bottom : run Reward := 0
def all-actions : run List Action := cons arg (cons spine nil)
def default-action : run Action := spine
def horizon : run Nat := suc 0

def all-states : run List State :=
  cons copy
    (cons copy4
      (cons copy8
        (cons len
          (cons ready
            (cons ready4
              (cons ready8
                (cons done
                  (cons cold
                    (cons wlen nil)))))))))
