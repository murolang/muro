                  | arg => λ (_ : Unit) → dom-refl Reward le le-refl (value w20)
                  | spine => λ (_ : Unit) → dom-w20-w4)
            | spine =>
                (match b motive (λ (z : Action) → Π (r : ranking affine spine z) → Dom Reward le (value w4) (successor-value affine z))
                  | arg => λ (_ : Unit) → dom-w4-w20
                  | spine => λ (_ : Unit) → dom-refl Reward le le-refl (value w4)))
      | discard =>
          (match a motive (λ (y : Action) → Π (r : ranking discard y b) → Dom Reward le (successor-value discard y) (successor-value discard b))
            | arg =>
                (match b motive (λ (z : Action) → Π (r : ranking discard arg z) → Dom Reward le (value w29) (successor-value discard z))
                  | arg => λ (_ : Unit) → dom-refl Reward le le-refl (value w29)
