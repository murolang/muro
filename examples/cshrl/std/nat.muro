-- nat.muro — the order on Nat, max, Bool, and the lemmas the CSHRL
-- library and its instances use. Le m n is a type that computes on
-- numerals: Unit when m ≤ n, Empty otherwise, so a closed inequality is
-- tt and a false one has no inhabitant.
import "bool.muro"

def Le : spec Π (m : Nat) → Π (n : Nat) → Type :=
  λ (m : Nat) → λ (n : Nat) →
    match m motive (λ _ → Type)
      | 0 => Unit
      | suc m1 =>
          (match n motive (λ _ → Type)
            | 0 => Empty
            | suc n1 => Le m1 n1)

def le-refl : evidence Π (n : Nat) → Le n n :=
  λ (n : Nat) →
    match n motive (λ (x : Nat) → Le x x)
      | 0 => tt
      | suc m => le-refl m

def le-zero : evidence Π (n : Nat) → Le 0 n :=
  λ (n : Nat) → tt

def le-trans : evidence Π (a : Nat) → Π (b : Nat) → Π (c : Nat) →
                        Π (ab : Le a b) → Π (bc : Le b c) → Le a c :=
  λ (a : Nat) →
    match a motive (λ (x : Nat) → Π (b : Nat) → Π (c : Nat) → Π (ab : Le x b) → Π (bc : Le b c) → Le x c)
      | 0 => λ (b : Nat) → λ (c : Nat) → λ (ab : Le 0 b) → λ (bc : Le b c) → tt
      | suc a1 => λ (b : Nat) →
          match b motive (λ (y : Nat) → Π (c : Nat) → Π (ab : Le (suc a1) y) → Π (bc : Le y c) → Le (suc a1) c)
            | 0 => λ (c : Nat) → λ (ab : Empty) → λ (bc : Le 0 c) →
                matchEmpty ab motive (λ _ → Le (suc a1) c)
            | suc b1 => λ (c : Nat) →
                match c motive (λ (z : Nat) → Π (ab : Le a1 b1) → Π (bc : Le (suc b1) z) → Le (suc a1) z)
                  | 0 => λ (ab : Le a1 b1) → λ (bc : Empty) →
                      matchEmpty bc motive (λ _ → Empty)
                  | suc c1 => λ (ab : Le a1 b1) → λ (bc : Le b1 c1) → le-trans a1 b1 c1 ab bc

-- The larger of two numbers. Each argument is used once.
def maxN : run Π (m : Nat) → Π (n : Nat) → Nat :=
  λ (m : Nat) → λ (n : Nat) →
    match m motive (λ _ → Nat)
      | 0 => n
      | suc p =>
          (match n motive (λ _ → Nat)
            | 0 => suc p
            | suc q => suc (maxN p q))

def le-maxN-left : evidence Π (m : Nat) → Π (n : Nat) → Le m (maxN m n) :=
  λ (m : Nat) →
    match m motive (λ (x : Nat) → Π (n : Nat) → Le x (maxN x n))
      | 0 => λ (n : Nat) → tt
      | suc p => λ (n : Nat) →
          match n motive (λ (y : Nat) → Le (suc p) (maxN (suc p) y))
            | 0 => le-refl p
            | suc q => le-maxN-left p q

def le-maxN-right : evidence Π (m : Nat) → Π (n : Nat) → Le n (maxN m n) :=
  λ (m : Nat) →
    match m motive (λ (x : Nat) → Π (n : Nat) → Le n (maxN x n))
      | 0 => λ (n : Nat) → le-refl n
      | suc p => λ (n : Nat) →
          match n motive (λ (y : Nat) → Le y (maxN (suc p) y))
            | 0 => tt
            | suc q => le-maxN-right p q

-- Addition is monotone in both arguments.
def plus-mono : evidence Π (a : Nat) → Π (b : Nat) → Π (c : Nat) → Π (d : Nat) →
                         Π (ab : Le a b) → Π (cd : Le c d) → Le (plus a c) (plus b d) :=
  λ (a : Nat) →
    match a motive (λ (x : Nat) → Π (b : Nat) → Π (c : Nat) → Π (d : Nat) → Π (ab : Le x b) → Π (cd : Le c d) → Le (plus x c) (plus b d))
      | 0 => λ (b : Nat) → λ (c : Nat) → λ (d : Nat) → λ (ab : Le 0 b) → λ (cd : Le c d) → plus-right b c d cd
      | suc a1 => λ (b : Nat) →
          match b motive (λ (y : Nat) → Π (c : Nat) → Π (d : Nat) → Π (ab : Le (suc a1) y) → Π (cd : Le c d) → Le (suc (plus a1 c)) (plus y d))
            | 0 => λ (c : Nat) → λ (d : Nat) → λ (ab : Empty) → λ (cd : Le c d) →
                matchEmpty ab motive (λ _ → Le (suc (plus a1 c)) d)
            | suc b1 => λ (c : Nat) → λ (d : Nat) → λ (ab : Le a1 b1) → λ (cd : Le c d) →
                plus-mono a1 b1 c d ab cd

-- c ≤ d gives c ≤ b + d.
def plus-right : evidence Π (b : Nat) → Π (c : Nat) → Π (d : Nat) → Π (cd : Le c d) → Le c (plus b d) :=
  λ (b : Nat) →
    match b motive (λ (x : Nat) → Π (c : Nat) → Π (d : Nat) → Π (cd : Le c d) → Le c (plus x d))
      | 0 => λ (c : Nat) → λ (d : Nat) → λ (cd : Le c d) → cd
      | suc b1 => λ (c : Nat) → λ (d : Nat) → λ (cd : Le c d) →
          le-trans c (plus b1 d) (suc (plus b1 d)) (plus-right b1 c d cd) (le-step (plus b1 d))

def le-step : evidence Π (n : Nat) → Le n (suc n) :=
  λ (n : Nat) →
    match n motive (λ (x : Nat) → Le x (suc x))
      | 0 => tt
      | suc m => le-step m

-- m ≤ n, decided.
def leb : run Π (m : Nat) → Π (n : Nat) → Bool :=
  λ (m : Nat) → λ (n : Nat) →
    match m motive (λ _ → Bool)
      | 0 => true
      | suc p =>
          (match n motive (λ _ → Bool)
            | 0 => false
            | suc q => leb p q)
