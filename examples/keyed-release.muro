-- A release order on one key. front and schema open when they
-- arrive, and they may be open together. worker stays held until
-- each of those kinds has resolved at least once for the key.
-- cleanup stays held until a worker has resolved. some_resolved is
-- that fact: one resolved instance of the kind. It is false when
-- none have arrived. resolved would hold with none.

data Step : Type where
  front : Step
  schema : Step
  worker : Step
  cleanup : Step

data Report : Type where
  ok : Report

session task-work := send Report end
session server-wait := recv Report end

conform task : task-work := put ok done

conform server : server-wait :=
  get (r : Report) done

meet slot : server with task buffer 1

family rollout : slot per key of Step
  front never held
  schema never held
  worker held until front resolved, schema resolved
  cleanup held until worker resolved

temporal front-before-worker : rollout :=
  forall (k : key). always ((opened k worker) implies (some_resolved k front))

temporal schema-before-worker : rollout :=
  forall (k : key). always ((opened k worker) implies (some_resolved k schema))

temporal worker-before-cleanup : rollout :=
  forall (k : key). always ((opened k cleanup) implies (some_resolved k worker))
