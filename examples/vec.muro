-- vec.muro — Fin n, Vec A n, lookup without a runtime bounds check.
data Fin : Nat → Type where
  fzero : Π (n : Nat) → Fin suc(n)
  fsuc  : Π (n : Nat) → Fin n → Fin suc(n)

data Vec (A : Type) : Nat → Type where
  vnil  : Vec A 0
  vcons : Π (n : Nat) → A → Vec A n → Vec A suc(n)

def pred : run Π (n : Nat) → Nat :=
  λ (n : Nat) →
    match n motive (λ _ → Nat)
      | 0 => 0
      | suc m => m

-- Each branch of a match on an indexed type is typed at its
-- constructor's own index. A motive that computes from the index carries
-- what the branch needs: at the scrutinee's index suc(m), Vec A (pred k)
-- is Vec A m, and the vcons p a as branch returns as : Vec A p. vnil
-- cannot produce suc(m), so its branch is skipped.
def vhead : run Π (-A : Type) → Π (-m : Nat) → Π (ys : Vec A suc(m)) → A :=
  λ (-A : Type) → λ (-m : Nat) → λ (ys : Vec A suc(m)) →
    match ys motive (λ (k : Nat) → λ (_ : Vec A k) → A)
      | vnil => 0
      | vcons p a as => a

def vtail : run Π (-A : Type) → Π (-m : Nat) → Π (ys : Vec A suc(m)) → Vec A m :=
  λ (-A : Type) → λ (-m : Nat) → λ (ys : Vec A suc(m)) →
    match ys motive (λ (k : Nat) → λ (_ : Vec A k) → Vec A (pred k))
      | vnil => 0
      | vcons p a as => as

def lookup : run Π (-A : Type) → Π (-n : Nat) → Π (i : Fin n) → Π (xs : Vec A n) → A :=
  λ (-A : Type) → λ (-n : Nat) → λ (i : Fin n) → λ (xs : Vec A n) →
    (match i motive (λ (k : Nat) → λ (_ : Fin k) → Vec A k → A)
      | fzero m => λ (ys : Vec A suc(m)) → vhead A m ys
      | fsuc m j => λ (ys : Vec A suc(m)) → lookup A m j (vtail A m ys)) xs

def ones1 : run Vec Nat suc(0) :=
  vcons 0 (suc 0) vnil

def lookup-ok : evidence {lookup Nat suc(0) (fzero 0) ones1 ≡ suc 0 : Nat} :=
  refl
