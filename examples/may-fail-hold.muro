-- The failure arm is present and does not release the slot. The
-- meeting checks. `leads_to` does not: the run where the task stops
-- leaves the server stopped with the slot held.

data Report : Type where
  ok : Report

session task-work := send Report end
session server-wait := recv Report end

conform task : task-work := put ok done

conform server : server-wait :=
  get (r : Report) done
  fail
    stop

meet hold : server with task may fail buffer 1

temporal held : hold := (server at first get) leads_to (server done)
