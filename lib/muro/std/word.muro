-- word.muro — unsigned checked arithmetic agrees with Nat.
--
-- wlink is the evidence. It accepts plus, minus, times, and Le only
-- as the standard definitions: plus from the prelude, minus and Le
-- from le.muro, and times from this book. A different binding is
-- refused. I64 is not here: toNat of −1 is 2^64−1, so the Nat
-- equation does not hold.

import "le.muro"

-- minus is le.muro's truncated subtraction. times is not in that book.
def times : run internal Π (+n : Nat) → Π (m : Nat) → Nat :=
  λ (+n : Nat) → λ (m : Nat) →
    match m motive (λ _ → Nat)
      | 0 => 0
      | suc mp => plus n (times n mp)

def addc-val-u8 : evidence
    Π (a : U8) → Π (b : U8) → Π (c : U8) →
    Π (h : {addc a b ≡ wsome c : Opt U8}) →
    {toNat c ≡ plus (toNat a) (toNat b) : Nat} :=
  λ (a : U8) → λ (b : U8) → λ (c : U8) →
  λ (h : {addc a b ≡ wsome c : Opt U8}) →
    wlink h

def addc-fit-u8 : evidence
    Π (a : U8) → Π (b : U8) → Π (c : U8) →
    Π (h : {addc a b ≡ wsome c : Opt U8}) →
    Le (suc (plus (toNat a) (toNat b))) 256 :=
  λ (a : U8) → λ (b : U8) → λ (c : U8) →
  λ (h : {addc a b ≡ wsome c : Opt U8}) →
    wlink h

def addc-some-u8 : evidence
    Π (a : U8) → Π (b : U8) →
    Π (h : Le (suc (plus (toNat a) (toNat b))) 256) →
    {addc a b ≡ wsome (toU8 (plus (toNat a) (toNat b))) : Opt U8} :=
  λ (a : U8) → λ (b : U8) →
  λ (h : Le (suc (plus (toNat a) (toNat b))) 256) →
    wlink h

def subc-val-u8 : evidence
    Π (a : U8) → Π (b : U8) → Π (c : U8) →
    Π (h : {subc a b ≡ wsome c : Opt U8}) →
    {toNat c ≡ minus (toNat a) (toNat b) : Nat} :=
  λ (a : U8) → λ (b : U8) → λ (c : U8) →
  λ (h : {subc a b ≡ wsome c : Opt U8}) →
    wlink h

def subc-fit-u8 : evidence
    Π (a : U8) → Π (b : U8) → Π (c : U8) →
    Π (h : {subc a b ≡ wsome c : Opt U8}) →
    Le (toNat b) (toNat a) :=
  λ (a : U8) → λ (b : U8) → λ (c : U8) →
  λ (h : {subc a b ≡ wsome c : Opt U8}) →
    wlink h

def subc-some-u8 : evidence
    Π (a : U8) → Π (b : U8) →
    Π (h : Le (toNat b) (toNat a)) →
    {subc a b ≡ wsome (toU8 (minus (toNat a) (toNat b))) : Opt U8} :=
  λ (a : U8) → λ (b : U8) →
  λ (h : Le (toNat b) (toNat a)) →
    wlink h

def mulc-val-u8 : evidence
    Π (a : U8) → Π (b : U8) → Π (c : U8) →
    Π (h : {mulc a b ≡ wsome c : Opt U8}) →
    {toNat c ≡ times (toNat a) (toNat b) : Nat} :=
  λ (a : U8) → λ (b : U8) → λ (c : U8) →
  λ (h : {mulc a b ≡ wsome c : Opt U8}) →
    wlink h

def mulc-fit-u8 : evidence
    Π (a : U8) → Π (b : U8) → Π (c : U8) →
    Π (h : {mulc a b ≡ wsome c : Opt U8}) →
    Le (suc (times (toNat a) (toNat b))) 256 :=
  λ (a : U8) → λ (b : U8) → λ (c : U8) →
  λ (h : {mulc a b ≡ wsome c : Opt U8}) →
    wlink h

def mulc-some-u8 : evidence
    Π (a : U8) → Π (b : U8) →
    Π (h : Le (suc (times (toNat a) (toNat b))) 256) →
    {mulc a b ≡ wsome (toU8 (times (toNat a) (toNat b))) : Opt U8} :=
  λ (a : U8) → λ (b : U8) →
  λ (h : Le (suc (times (toNat a) (toNat b))) 256) →
    wlink h

