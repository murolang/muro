def minus-closed : evidence {minus 5 3 ≡ 2 : Nat} := refl

def times-closed : evidence {times 4 3 ≡ 12 : Nat} := refl

def boundary-u64 : evidence
    {addc (toU64 4294967295) (toU64 1) ≡ wsome (toU64 4294967296) : Opt U64} :=
  refl

def boundary-u32 : evidence
    {addc (toU32 4294967295) (toU32 1) ≡ wnone : Opt U32} :=
  refl

def boundary-mul : evidence
    {mulc (toU64 4294967296) (toU64 4294967296) ≡ wnone : Opt U64} :=
  refl

def cup : run U8 := toU8 200

def lid : run U8 := toU8 50

def cup-bound : evidence Le (suc (plus (toNat cup) (toNat lid))) 256 := tt

def cup-sum : evidence
    {addc cup lid ≡ wsome (toU8 (plus (toNat cup) (toNat lid))) : Opt U8} :=
  addc-some-u8 cup lid cup-bound

-- Centidollars. The sums are closed, and the equations cite the lemmas.
def coffee : run U64 := toU64 100

def tip : run U64 := toU64 25

def tax : run U64 := toU64 10

def line-bound : evidence
    Le (suc (plus (toNat coffee) (toNat tip))) 18446744073709551616 :=
  tt

def line : evidence
    {addc coffee tip ≡ wsome (toU64 (plus (toNat coffee) (toNat tip))) : Opt U64} :=
  addc-some-u64 coffee tip line-bound

def line-nat : evidence
    {toNat (toU64 (plus (toNat coffee) (toNat tip))) ≡ plus (toNat coffee) (toNat tip) : Nat} :=
  addc-val-u64 coffee tip (toU64 (plus (toNat coffee) (toNat tip))) line

-- 100 + 25, the closed word. line-nat is that sum as Nat.
def subtotal : run U64 := toU64 125

def bill-bound : evidence
    Le (suc (plus (toNat subtotal) (toNat tax))) 18446744073709551616 :=
  tt

def bill : evidence
    {addc subtotal tax ≡ wsome (toU64 (plus (toNat subtotal) (toNat tax))) : Opt U64} :=
  addc-some-u64 subtotal tax bill-bound

def bill-nat : evidence
    {toNat (toU64 (plus (toNat subtotal) (toNat tax))) ≡ plus (toNat subtotal) (toNat tax) : Nat} :=
  addc-val-u64 subtotal tax (toU64 (plus (toNat subtotal) (toNat tax))) bill
